# ============================================
# LEGACY CUSTOMER DATA IMPORT - ENVIRONMENT CONFIGURATION
# ============================================
#
# Copy this file to .env and customize for your environment
# CRITICAL: Change all default values for production!
#

# ============================================
# DATABASE CONFIGURATION
# ============================================

# MongoDB connection string (local development)
MONGO_URI=mongodb://localhost:27017/legacy_import

# MongoDB connection string for tests
MONGO_URI_TEST=mongodb://localhost:27017/test_db

# ============================================
# AUTHENTICATION CONFIGURATION
# ============================================

# JWT Secret: Generate with: openssl rand -base64 32
# CRITICAL: Change this in production!
JWT_SECRET=your-super-secret-key-change-this-in-production

# JWT token expiration time
JWT_EXPIRY=24h

# Admin API Key (used for initial authentication)
# Generate with: openssl rand -hex 32
# CRITICAL: Change this in production!
ADMIN_API_KEY=admin-default-key-change-this

# User/Standard API Key
# Generate with: openssl rand -hex 32
# CRITICAL: Change this in production!
USER_API_KEY=user-default-key-change-this

# ============================================
# SERVER CONFIGURATION
# ============================================

# Server port
PORT=3000

# Environment (development, production, test)
NODE_ENV=development

# CORS Origin (allowed domains for cross-origin requests)
# Note: Don't use '*' in production
CORS_ORIGIN=http://localhost:3000

# ============================================
# RATE LIMITING CONFIGURATION (Optional)
# ============================================

# General API rate limit window (milliseconds)
# Default: 900000 (15 minutes)
# RATE_LIMIT_WINDOW=900000

# General API rate limit max requests per window
# Default: 100
# RATE_LIMIT_MAX=100

# Authentication rate limit max attempts
# Default: 5 per 15 minutes
# AUTH_RATE_LIMIT_MAX=5

# Upload rate limit max uploads
# Default: 10 per 1 hour
# UPLOAD_RATE_LIMIT_MAX=10

# ============================================
# LOGGING CONFIGURATION (Optional)
# ============================================

# Log level (debug, info, warn, error)
# LOG_LEVEL=info

# Enable detailed request logging
# DEBUG=false

# ============================================
# SECURITY CONFIGURATION (Optional)
# ============================================

# Maximum CSV file size (bytes)
# Default: 52428800 (50 MB)
# CSV_MAX_FILE_SIZE=52428800

# Maximum CSV rows per file
# Default: 100000
# CSV_MAX_ROWS=100000

# Maximum CSV columns per row
# Default: 100
# CSV_MAX_COLUMNS=100

# Maximum size per CSV cell (bytes)
# Default: 1048576 (1 MB)
# CSV_MAX_CELL_SIZE=1048576

# ============================================
# PRODUCTION DEPLOYMENT GUIDE
# ============================================
#
# Before deploying to production:
#
# 1. Change all default values:
#    - Generate new JWT_SECRET: openssl rand -base64 32
#    - Generate new ADMIN_API_KEY: openssl rand -hex 32
#    - Generate new USER_API_KEY: openssl rand -hex 32
#
# 2. Set NODE_ENV=production
#
# 3. Configure for your domain:
#    - Update CORS_ORIGIN to your frontend domain
#    - Enable HTTPS (configure reverse proxy)
#
# 4. Use production MongoDB:
#    - Update MONGO_URI to production MongoDB instance
#    - Enable MongoDB authentication
#    - Configure MongoDB backups
#
# 5. Implement additional security:
#    - Use a secrets manager (AWS Secrets Manager, HashiCorp Vault)
#    - Enable audit logging
#    - Configure monitoring and alerting
#    - Set up log aggregation
#
# See SECURITY_PRODUCTION.md for complete deployment guide
#
